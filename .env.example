# ============================================
# 🔐 Cek API — Environment Variables
# ============================================
# Salin file ini jadi .env lalu isi nilainya:
#   cp .env.example .env
# (atau di Windows: copy .env.example .env)
# ============================================

# ── Keamanan (WAJIB diisi sebelum deploy) ────────────────────
# Password login dashboard (minimal 4 karakter)
AUTH_PASSWORD=abnibasith14

# Kunci rahasia session + enkripsi key (minimal 16 karakter random)
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=admin123

# ── Supabase (WAJIB untuk production) ─────────────────────────
# Dari: Supabase Dashboard → Project Settings → API
# URL = "Project URL" (https://xxxx.supabase.co)
# SERVICE_KEY = "service_role" secret key (JANGAN pakai anon key!)
SUPABASE_URL=https://isdyuxbjzxdnyudpzoiz.supabase.co
SUPABASE_SERVICE_KEY=sb_publishable_mhaqf4lwNM4KiWBawkwQ8Q__ey0inmI

# ── Opsional ─────────────────────────────────────────────────
# URL publik app — dipakai script reset password buat bikin link
# Contoh: https://cek-api.vercel.app
# Default: http://localhost:3000
APP_URL=http://localhost:3000
